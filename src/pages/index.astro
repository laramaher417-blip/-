---
import integrations from "../data/integrations.json";

const title = "Micro-SaaS Integration Directory";
const items = Array.isArray(integrations) ? integrations : [];
const categories = ["All", ...new Set(items.map((item) => item?.category).filter(Boolean))];
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root {
        --bg: #fbfaf7;
        --surface: #ffffff;
        --ink: #18181b;
        --muted: #52525b;
        --border: #e7e5e4;
        --accent: #1e3a34;
        --accent-soft: #eef4f2;
        --profit-bg: #f5f3ff;
        --profit-ink: #3b2f63;
      }

      * {
        box-sizing: border-box;
      }

      body {
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        max-width: 920px;
        margin: 3.5rem auto;
        padding: 0 1.25rem 4rem;
        background: var(--bg);
        color: var(--ink);
        line-height: 1.65;
      }

      header {
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--border);
      }

      .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.5rem;
      }

      .nav-link {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--accent);
        text-decoration: none;
        padding: 0.35rem 0.85rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface);
        transition: all 0.15s ease;
      }

      .nav-link:hover {
        background: var(--accent-soft);
        border-color: var(--accent);
      }

      .eyebrow {
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
      }

      h1 {
        margin: 0 0 0.5rem;
        font-size: 2.15rem;
        font-weight: 750;
        letter-spacing: -0.02em;
      }

      .subtitle {
        margin: 0;
        color: var(--muted);
        font-size: 1rem;
      }

      .controls {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
        margin-bottom: 2rem;
      }

      .search-input {
        flex: 1 1 260px;
        padding: 0.7rem 1rem;
        border: 1px solid #d6d3d1;
        border-radius: 10px;
        font-size: 0.95rem;
        background: var(--surface);
        color: var(--ink);
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }

      .search-input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(30, 58, 52, 0.1);
      }

      .filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .filter-btn {
        padding: 0.5rem 0.95rem;
        border: 1px solid #d6d3d1;
        border-radius: 999px;
        background: var(--surface);
        color: var(--muted);
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .filter-btn:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      .filter-btn.active {
        background: var(--accent);
        border-color: var(--accent);
        color: #ffffff;
      }

      .grid {
        display: grid;
        gap: 1.35rem;
      }

      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.5rem 1.65rem;
        box-shadow: 0 4px 16px rgba(24, 24, 27, 0.03);
        transition: transform 0.15s ease, border-color 0.15s ease;
      }

      .card:hover {
        border-color: #d6d3d1;
        transform: translateY(-1px);
      }

      .meta {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        font-size: 0.82rem;
        color: var(--muted);
        margin-bottom: 0.6rem;
      }

      .badge {
        background: var(--accent-soft);
        color: var(--accent);
        padding: 0.2rem 0.7rem;
        border-radius: 999px;
        font-weight: 700;
      }

      h2 {
        margin: 0.25rem 0 0.55rem;
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: -0.01em;
      }

      .tool-link {
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1.5px solid transparent;
        transition: color 0.15s ease, border-color 0.15s ease;
      }

      .tool-link:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
      }

      .tool-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin-bottom: 0.9rem;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--accent);
        background: var(--accent-soft);
        padding: 0.35rem 0.8rem;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.15s ease, transform 0.15s ease;
      }

      .tool-cta:hover {
        background: #dcebe6;
        transform: translateX(2px);
      }

      .summary {
        margin: 0 0 0.9rem;
        color: #3f3f46;
      }

      ul {
        margin: 0.5rem 0 1rem;
        padding-left: 1.35rem;
        color: var(--muted);
      }

      li {
        margin-bottom: 0.3rem;
      }

      .monetization {
        font-size: 0.9rem;
        color: var(--profit-ink);
        background: var(--profit-bg);
        padding: 0.75rem 1rem;
        border-radius: 10px;
        border-left: 3px solid #6d28d9;
      }

      .empty-state {
        text-align: center;
        padding: 2.25rem;
        background: var(--surface);
        border: 1px dashed #d6d3d1;
        border-radius: 14px;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <header>
      <div class="top-bar">
        <span class="eyebrow">Curated Playbooks</span>
        <a href="/contact" class="nav-link">Contact</a>
      </div>
      <h1>{title}</h1>
      <p class="subtitle">
        Practical workflows and integration blueprints for lean software products (
        <span id="visible-count">{items.length}</span> of {items.length} shown).
      </p>
    </header>

    <section class="controls" aria-label="Search and filter integrations">
      <input
        id="search-input"
        class="search-input"
        type="search"
        placeholder="Search by workflow, tool, or business opportunity..."
        autocomplete="off"
      />
      <div class="filters" id="category-filters">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`filter-btn ${idx === 0 ? "active" : ""}`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </section>

    <main class="grid" id="cards-grid">
      {items.map((item) => {
        const targetUrl = item.affiliate_url || item.url || "";
        return (
          <article
            class="card"
            data-category={item.category || ""}
            data-search={`${item.name || ""} ${item.category || ""} ${item.summary || ""} ${item.monetization_angle || ""} ${(item.setup_steps || []).join(" ")}`.toLowerCase()}
          >
            <div class="meta">
              <span class="badge">{item.category}</span>
              {item.created_at && <span>Updated {item.created_at}</span>}
            </div>
            <h2>
              {targetUrl ? (
                <a
                  href={targetUrl}
                  class="tool-link"
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                >
                  {item.name} ↗
                </a>
              ) : (
                item.name
              )}
            </h2>
            {targetUrl && (
              <div>
                <a
                  href={targetUrl}
                  class="tool-cta"
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                >
                  Open Tool →
                </a>
              </div>
            )}
            <p class="summary">{item.summary}</p>
            {Array.isArray(item.setup_steps) && item.setup_steps.length > 0 && (
              <ul>
                {item.setup_steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ul>
            )}
            {item.monetization_angle && (
              <div class="monetization">
                <strong>Monetization Angle:</strong> {item.monetization_angle}
              </div>
            )}
          </article>
        );
      })}
    </main>

    <div id="empty-state" class="empty-state" style="display: none;">
      No matching integrations found. Try clearing your search or selecting "All".
    </div>

    <footer style="margin-top: 3rem; padding: 1.35rem 1.75rem; border-radius: 14px; background: linear-gradient(135deg, #0f766e 0%, #4f46e5 100%); color: #ffffff; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; font-size: 0.92rem; box-shadow: 0 8px 24px rgba(79, 70, 229, 0.18);">
      <div>
        <div style="font-weight: 600;">&copy; 2026 MicroSaaS Stack. All rights reserved.</div>
        <div style="font-size: 0.78rem; opacity: 0.9; margin-top: 0.2rem;">
          Some external tool links may be affiliate links that earn a commission at no extra cost to you.
        </div>
      </div>
      <a href="/contact" style="background: #ffffff; color: #312e81; font-weight: 700; text-decoration: none; padding: 0.45rem 1rem; border-radius: 999px;">Contact</a>
    </footer>

    <script is:inline>
      (() => {
        const searchInput = document.getElementById("search-input");
        const filterButtons = Array.from(document.querySelectorAll(".filter-btn"));
        const cards = Array.from(document.querySelectorAll("#cards-grid .card"));
        const countEl = document.getElementById("visible-count");
        const emptyEl = document.getElementById("empty-state");

        let activeCategory = "All";

        function applyFilters() {
          const query = (searchInput?.value || "").trim().toLowerCase();
          let visibleCount = 0;

          cards.forEach((card) => {
            const cardCat = card.getAttribute("data-category") || "";
            const haystack = card.getAttribute("data-search") || "";
            const matchesCategory = activeCategory === "All" || cardCat === activeCategory;
            const matchesQuery = !query || haystack.includes(query);
            const show = matchesCategory && matchesQuery;

            card.style.display = show ? "" : "none";
            if (show) visibleCount += 1;
          });

          if (countEl) countEl.textContent = String(visibleCount);
          if (emptyEl) emptyEl.style.display = visibleCount === 0 ? "" : "none";
        }

        searchInput?.addEventListener("input", applyFilters);

        filterButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            activeCategory = btn.getAttribute("data-category") || "All";
            filterButtons.forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
            applyFilters();
          });
        });
      })();
    </script>
  </body>
</html>
